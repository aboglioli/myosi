# sysusers.d(5) lines, applied by systemd-sysusers.service on every boot.
# A regular (non-homed) user: no encrypted home, so `loginctl enable-linger`
# works and rootless podman survives a logout — which is why headless hosts
# want this rather than a homed user.
#
#   type name  id            gecos            home            shell
u     alan  1000:1000     "Alan"           /home/alan      /usr/bin/fish
m     alan  wheel
m     alan  video
m     alan  render
m     alan  input
