#!/usr/bin/env bash
# Main myosi image finalize.
#
# All work is shared with sub-image builds (mybox) and lives in
# mkosi.shared/finalize-common.sh — /etc → /usr/share/factory/etc snapshot + /etc
# wipe + baseline-sysext bake (no current consumer).

set -euo pipefail

SRCDIR="${SRCDIR:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")}"

source "${SRCDIR}/mkosi.shared/finalize-common.sh"
