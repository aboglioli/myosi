[Build]
WorkspaceDirectory=/var/home/<user>/.cache/mkosi-workspace

[Config]
Profiles=containers
Profiles=virt
Dependencies=desktop
Dependencies=nvidia
# Dependencies=mybox

# QEMU testing overrides — SecureBoot-free + serial console so `just
# qemu` boots under plain UEFI. NEVER ship to real hardware with these:
# they unwind the production boot trust chain.

[Output]
CompressOutput=no

[Content]
ShimBootloader=none
KernelCommandLine=console=ttyS0

[Runtime]
Register=no
Firmware=uefi
