# Local developer overrides (never commit)
mkosi.local.conf
mkosi.local/
.local/

# Build artifacts
build/
*.raw
*.raw.xz
*.efi
*.verity
*.verity-sig

# Local signing keys and generated OVMF varstore
keys/*.key
keys/*.crt
keys/*.fd

# Bootstrap LUKS key — same lifecycle as boot.key / image.key:
# generated once locally, sourced from the $MYOSI_DATA_KEY secret in
# CI. mkosi.postinst installs it into the image and the initrd.
keys/data.key

# mkosi auto-generates these at the project root if SecureBootKey/Cert
# aren't both pinned. Ephemeral, never commit.
mkosi.key
mkosi.crt

# Sub-image build outputs mkosi v26 drops next to each sub-image's
# mkosi.conf (initrd cpio, kernel binary, extracted rootfs tree,
# symlinks, stray .raw/.efi).
mkosi.images/*/*.cpio
mkosi.images/*/*.cpio.zst
mkosi.images/*/*.initrd
mkosi.images/*/*.vmlinuz
mkosi.images/*/initrd
mkosi.images/base-tree/base-tree/
mkosi.images/containers/containers/
mkosi.images/desktop/desktop/
mkosi.images/virt/virt/
mkosi.images/nvidia/nvidia/
mkosi.images/nvidia-580xx/nvidia-580xx/
mkosi.images/zfs/zfs/
mkosi.images/initrd/initrd/
mkosi.images/mybox/mybox/
mkosi.images/*/[a-z]*.raw
mkosi.images/*/[a-z]*.raw.xz
mkosi.images/*/[a-z]*.raw.zst
mkosi.images/*/[a-z]*.efi

# CI writes packages/pinned-kernel.txt per release as a pure build
# audit output — nothing consumes it as a source.
packages/

# mkosi caches
mkosi.cache/
mkosi.builddir/
mkosi.output/


# Editor + OS noise
.direnv/
.envrc
*.swp
*.swo
.DS_Store
credentials/*.cred
