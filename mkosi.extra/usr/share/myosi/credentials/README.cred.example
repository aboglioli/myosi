# myosi first-boot credentials (reference)
#
# systemd-creds(1) reads credentials from any of:
#
#   /etc/credstore/<name>             plaintext, owner-root mode 0600
#   /etc/credstore.encrypted/<name>   encrypted-at-rest with systemd-creds encrypt
#                                     (TPM2-sealed or host-key-sealed)
#   ESP first-boot delivery           /EFI/Linux/<UKI>.efi.extra.d/<name>.cred
#                                     (systemd-stub reads at boot, exposes
#                                     via @system credentials)
#   SMBIOS Type 11 OEM strings        firmware-provided creds (cloud,
#                                     fleet provisioning, KVM/qemu -smbios)
#   Kernel cmdline                    systemd.set_credential=<name>:<value>
#                                     (plaintext, visible in /proc/cmdline —
#                                     avoid for secrets)
#
# systemd-firstboot reads (on first boot, ConditionFirstBoot=yes):
#
#   firstboot.locale            -> /etc/locale.conf
#   firstboot.locale-messages   -> /etc/locale.conf
#   firstboot.keymap            -> /etc/vconsole.conf
#   firstboot.timezone          -> /etc/timezone (symlink to /usr/share/zoneinfo/...)
#   firstboot.hostname          -> /etc/hostname (overrides the baked default)
#   firstboot.machine-id        -> /etc/machine-id (if not already set by initrd)
#   passwd.hashed-password.root -> /etc/shadow root entry (mkpasswd -m sha512crypt)
#   passwd.plaintext-password.root  -> same, plaintext (avoid)
#   passwd.shell.root           -> /etc/passwd root shell
#
# sshd (myosi 50-myosi.conf overrides AuthorizedKeysFile) reads:
#
#   ssh.authorized_keys.root    -> appended to /etc/ssh/authorized_keys.d
#                                  search path; sshd reads at session setup
#                                  (no service restart needed)
#   ssh.ephemeral-authorized_keys-all  -> same, ephemeral
#
# myosi sysroot-prep (initrd) reads:
#
#   data.key                    -> LUKS2 passphrase for /var/home data
#                                  partition. If absent, sysroot-prep
#                                  prompts interactively via
#                                  systemd-ask-password.
#
# ---- Quick-start example: encrypt the LUKS passphrase + hostname ----
#
#   # Generate a passphrase, store it sealed against the host's TPM2:
#   printf 'correct horse battery staple' \
#     | systemd-creds encrypt --name=data.key --with-key=tpm2 - \
#         /etc/credstore.encrypted/data.key
#
#   # Set the hostname for first boot (no TPM seal — operator-readable):
#   printf 'myhost-01' \
#     | systemd-creds encrypt --name=firstboot.hostname --with-key=host - \
#         /etc/credstore.encrypted/firstboot.hostname
#
#   # SSH key (TPM2-sealed so a stolen disk image can't extract it):
#   systemd-creds encrypt --name=ssh.authorized_keys.root \
#       --with-key=tpm2 \
#       ~/.ssh/id_ed25519.pub \
#       /etc/credstore.encrypted/ssh.authorized_keys.root
#
# All three are now picked up automatically on first boot — no install-
# script flags, no kickstart, no interactive prompts.
#
# ---- USB-stick delivery (Phase C: one-image USB↔installed) ----
#
# Drop encrypted creds onto the ESP partition of the USB stick:
#
#   /efi/loader/credentials/<name>.cred
#
# systemd-stub reads them at boot and exposes them under @system.
# This is how the "single image works as USB live AND installed root"
# pattern delivers per-host config without rebuilding the image.
