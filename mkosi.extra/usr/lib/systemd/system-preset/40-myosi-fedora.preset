# Fedora-shipped units myosi opts into. Presets are read
# lexicographically, first match wins: this file (40) beats 50-myosi and
# the base-tree's 99-default-disable catch-all `disable *`.

# Network + remote access
enable sshd.service
enable firewalld.service
enable NetworkManager.service
enable systemd-resolved.service

# Sysext + UKI boot bookkeeping
enable systemd-sysext.service
enable systemd-bless-boot.service

# homed owns interactive users (declarative records via
# home.create.<name> credentials, consumed on first boot only);
# userdbd is the NSS bridge so getent resolves homed users/groups.
enable systemd-homed.service
enable systemd-userdbd.service
# NOT enabled: home.create.<name> is unusable on systemd 259 (a record with
# a `secret` section is rejected outright, without one homectl blocks on a
# password prompt), and it would bypass user-provision anyway — no subuid,
# no sysext groups, no linger. Users are declared as an identity record and
# created by myosi-users.service instead. See credentials/README.md.
disable systemd-homed-firstboot.service

# bootc auto-update conflicts with sysupdate-driven UKI rollover.
disable bootc-fetch-apply-updates.timer
