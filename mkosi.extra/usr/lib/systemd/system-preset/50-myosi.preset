# Main-image unit activation policy (applied by preset-all in postinst).
# Tier split: main-image units -> enable here; initrd-only units -> static
# .wants/ in mkosi.images/initrd (preset doesn't reach initrd);
# profile/sysext units -> target drop-in (works both baked and
# sysext-merged, unlike .wants/). Pick the verb by unit shape, NOT by
# habit: Upholds= only for units that STAY active (sockets, daemons) —
# it re-evaluates on refresh + daemon-reload; Wants= for oneshots and
# anything Condition-gated, because Upholds= busy-loops retrying a unit
# that goes inactive. See README "Enabling units without presets".
# preset-all silently skips lines whose unit isn't in main /usr.

enable myosi-sysext-relabel.service
enable myosi-glib-schemas-compile.service
# Self-gating on a battery; inert on non-laptops.
enable myosi-power-tune.service

# No interactive user is baked: homed cannot rename a user later (no
# `homectl rename` in 259), so a public image must not pick the name. The host
# picks it instead, either from a home.create.<name> / sysusers.extra
# credential on the ESP before the first boot (credentials/README.md), or from
# `myosi user-create` afterwards.

# No dotfiles seeding into $HOME: homed activates the encrypted home at PAM
# login, so a build-time copy would be shadowed by the LUKS mount.

# Explicit mounts for all data subvolumes: gpt-auto-generator is unreliable
# on verity-protected installs (systemd 259), so we own every post-pivot
# mount; explicit Options= keeps zstd:3 + noatime.
enable efi.mount
enable var.mount
enable home.mount
enable srv.mount
