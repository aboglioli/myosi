# Main-image unit activation policy (applied by preset-all in postinst).
# Tier split: main-image units -> enable here; initrd-only units -> static
# .wants/ in mkosi.images/initrd (preset doesn't reach initrd);
# profile/sysext units -> Upholds= drop-in on the target (works both baked
# and sysext-merged; unlike .wants/, Upholds= re-evaluates on runtime
# sysext refresh + daemon-reload, so units auto-start without reboot).
# preset-all silently skips lines whose unit isn't in main /usr.

enable myosi-sysext-relabel.service
enable myosi-glib-schemas-compile.service

# Homed user provisioning: materializes /usr/share/myosi/users/<instance>.user
# on first boot. NOTE: preset-all does NOT honor template-instance enables
# during postinst (no concrete instance on disk to enumerate) — the default
# user is enabled via a static .wants/ symlink instead. Line kept for the
# operator-side `systemctl preset` path, which does honor instances.
enable myosi-homed-user@user.service

# No dotfiles seeding into $HOME: homed activates the encrypted home at PAM
# login, so a build-time copy would be shadowed by the LUKS mount.

# Explicit mounts for all data subvolumes: gpt-auto-generator is unreliable
# on verity-protected installs (systemd 259), so we own every post-pivot
# mount; explicit Options= keeps zstd:3 + noatime.
enable efi.mount
enable var.mount
enable home.mount
enable srv.mount
