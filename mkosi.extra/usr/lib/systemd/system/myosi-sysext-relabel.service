[Unit]
Description=Restore SELinux labels on mutable /etc after sysext merges
Documentation=man:systemd-sysext(8)
ConditionSecurity=selinux
After=systemd-sysext.service
# Before=sshd-keygen.target is belt-and-suspenders so host keys land as
# sshd_key_t even if /etc/ssh is briefly under a wrong parent label.
Before=systemd-user-sessions.service sshd.service sshd-keygen.target login.service multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
# Only /etc: sysext raws are read-only erofs/verity lowerdirs, so runtime
# restorecon can't persist xattrs there — those labels are baked at build
# time via mkfs.erofs --file-contexts (mkosi.shared/sysext.conf).
ExecStart=-/usr/sbin/restorecon -iRF /etc

[Install]
WantedBy=multi-user.target
