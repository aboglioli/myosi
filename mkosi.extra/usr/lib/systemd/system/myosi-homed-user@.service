[Unit]
Description=Provision homed-managed user %i (create record + bind sysext groups)
Documentation=file:///usr/libexec/myosi/user-provision
DefaultDependencies=yes
After=systemd-homed.service local-fs.target
Wants=systemd-homed.service
# Order before getty so the login prompt appears AFTER the user has
# been materialized on first boot — avoids the "Login incorrect" UX
# trap where the operator types the correct password while homectl
# create is still formatting the LUKS image.
Before=getty.target

[Service]
Type=oneshot
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/libexec/myosi/user-provision --storage=homed %i
# First-boot homectl create on emulated TPM / slow CPUs can take
# 5-10 min to format the LUKS image and initialise the inner btrfs.
# Real hardware with AES-NI completes in seconds.
TimeoutStartSec=15min

[Install]
WantedBy=multi-user.target
# No DefaultInstance=: it would let an instance-less `systemctl enable` create
# the generic `user` the image no longer ships.
