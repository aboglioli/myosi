[Unit]
Description=Compile union GSettings schema cache from merged sysexts
Documentation=man:glib-compile-schemas(1) man:systemd-sysext(8)

# After the sysext merge /usr/share/glib-2.0/schemas is the overlay union;
# only needs to finish before logins open (user sessions read
# environment.d). Do NOT add DefaultDependencies=no + Before=basic.target
# or RequiresMountsFor=/usr/...: that closed an ordering cycle through
# sysinit.target and got this job deleted. After=systemd-sysext.service
# already implies /usr is ready.
After=systemd-sysext.service
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Output on /run tmpfs: rebuilt each boot from whatever sysext set merged.
ExecStartPre=/usr/bin/mkdir -p /run/myosi/glib-schemas/glib-2.0/schemas
ExecStart=/usr/bin/glib-compile-schemas \
    --targetdir=/run/myosi/glib-schemas/glib-2.0/schemas \
    /usr/share/glib-2.0/schemas

# A broken cache must not block boot — GTK apps fall back to defaults.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
