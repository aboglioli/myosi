[Unit]
Description=/efi (EFI System Partition)
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
DefaultDependencies=no
# Same shape as var/home/srv.mount: bind to the backing device (stable
# GPT label `esp` from repart 00-esp.conf), mount before local-fs.target.
# gpt-auto fails entirely on verity-protected installs (systemd 259), so
# this explicit unit is what actually mounts /efi — without it bootctl,
# boot-random-seed, and the sysupdate UKI transfer (which would hit the
# read-only rootfs stub /efi) all fail.
Conflicts=umount.target
Before=local-fs.target umount.target
After=dev-disk-by\x2dpartlabel-esp.device blockdev@dev-disk-by\x2dpartlabel-esp.target
BindsTo=dev-disk-by\x2dpartlabel-esp.device

[Mount]
What=/dev/disk/by-partlabel/esp
Where=/efi
Type=vfat
# umask=0077: only root reads the ESP (boot secrets, random seed).
Options=defaults,umask=0077,shortname=winnt,discard,noatime

[Install]
WantedBy=local-fs.target
