[Unit]
Description=/var (btrfs subvolume on data-luks)
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
# Shadows gpt-auto's var.mount, which would mount with btrfs defaults —
# explicit Options= keeps compress=zstd:3 + noatime + subvol=/var.
# Bind to the mapper device: the real precondition is /dev/mapper/data
# existing, and BindsTo= tears down cleanly. Same shape as home/srv.mount.
After=dev-mapper-data.device
BindsTo=dev-mapper-data.device
Before=local-fs.target

[Mount]
What=/dev/mapper/data
Where=/var
Type=btrfs
Options=defaults,noatime,compress=zstd:3,subvol=/var

[Install]
WantedBy=local-fs.target
