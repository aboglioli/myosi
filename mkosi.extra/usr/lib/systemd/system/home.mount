[Unit]
Description=/home (btrfs subvolume on data-luks)
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
# Sibling subvol of the data-luks btrfs; DPS can't express btrfs
# subvolumes, so it's mounted explicitly here. (/etc must instead be
# mounted in the initrd — PID 1 reads it synchronously at startup.)
# Bind to the mapper device, not var.mount: the real precondition is
# /dev/mapper/data existing, and BindsTo= tears down cleanly.
After=dev-mapper-data.device
BindsTo=dev-mapper-data.device
Before=local-fs.target

[Mount]
What=/dev/mapper/data
Where=/home
Type=btrfs
Options=defaults,noatime,compress=zstd:3,subvol=/home

[Install]
WantedBy=local-fs.target
