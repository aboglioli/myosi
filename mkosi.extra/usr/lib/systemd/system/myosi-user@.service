[Unit]
Description=Provision classic user %i (create account + bind sysext groups + linger)
Documentation=file:///usr/libexec/myosi/user-provision
DefaultDependencies=yes
# No homed dependency by design: this mode exists for hosts where nobody
# authenticates, so nothing may wait on an unlock that never comes.
After=local-fs.target
# The home lands on the /home subvolume, so that mount has to be there first.
RequiresMountsFor=/home
# Order before getty for the same reason as the homed unit: the login prompt
# should not appear while the account is still being created.
Before=getty.target

[Service]
Type=oneshot
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/libexec/myosi/user-provision --storage=classic %i
# useradd plus a restorecon over a fresh home. No LUKS image to format, so
# this needs nothing like the homed unit's 15 minutes.
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
# No DefaultInstance=: it would let an instance-less `systemctl enable` create
# the generic `user` the image no longer ships.
