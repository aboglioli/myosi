[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/var/lib/sysupdate
# @u captures the PartitionUUID embedded in the filename (first 16 bytes
# of the verity root hash) and writes it into the target GPT entry. This
# is mandatory: veritysetup-generator derives the expected PARTUUID from
# roothash= on the cmdline; without @u the placeholder PARTUUID remains
# and boot times out at dev-mapper-root.device. %a matches the release
# pipeline's Output=%i_%v_%a arch stamp.
MatchPattern=myosi_@v_%a_@u.root.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=root-@v
MatchPartitionType=root
PartitionFlags=0
ReadOnly=1
