[Transfer]
ProtectVersion=%A
# Verify=false: sysupdate's GPG verification covers only the SHA256SUMS
# manifest (payload hashes are ALWAYS checked against it). The artifacts
# authenticate themselves — root/verity carry a PKCS#7 verity signature
# validated by the kernel .platform keyring at boot, the UKI is
# SecureBoot-signed — and the manifest travels over HTTPS. Flip to GPG
# later by signing SHA256SUMS.gpg in CI and shipping the public key at
# /etc/systemd/import-pubring.pgp.
Verify=false

[Source]
# Public GitHub release, native sysupdate fetch: the URL is suffixed
# with /SHA256SUMS (version enumeration + payload hashes) and the asset
# names listed in the manifest. GitHub's 302 to
# objects.githubusercontent.com is followed. Only the LATEST release is
# visible through this URL — fine, sysupdate only ever installs the
# newest complete version.
Type=url-file
Path=https://github.com/aboglioli/myosi/releases/latest/download/
# @u captures the PartitionUUID embedded in the filename (first 16 bytes
# of the verity root hash) and writes it into the target GPT entry. This
# is mandatory: veritysetup-generator derives the expected PARTUUID from
# roothash= on the cmdline; without @u the placeholder PARTUUID remains
# and boot times out at dev-mapper-root.device. %a matches the release
# pipeline's Output=%i_%v_%a arch stamp.
MatchPattern=myosi_@v_%a_@u.root.raw.zst

[Target]
Type=partition
Path=auto
MatchPattern=root-@v
MatchPartitionType=root
PartitionFlags=0
ReadOnly=1
