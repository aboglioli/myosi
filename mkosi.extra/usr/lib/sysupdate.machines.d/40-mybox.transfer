[Transfer]
# Opt-in mybox nspawn DDI update: replaces the single sealed verity-erofs
# .raw wholesale. Separate sysupdate.machines.d/ COMPONENT (not the main
# dir) on purpose: the post-update verb is machinectl restart, not sysext
# refresh, and mybox is not part of every release — inside the main dir a
# missing mybox asset would make the whole version invisible to hosts
# with the feature enabled. Enable via
# /etc/sysupdate.machines.d/mybox.feature.d/enable.conf.
Features=mybox
ProtectVersion=%A
# See sysupdate.d/10-root.transfer for the Verify=/url-file rationale.
Verify=false

[Source]
Type=url-file
Path=https://github.com/aboglioli/myosi/releases/latest/download/
# %a matches mkosi's Output=%i_%v_%a stamp, so the lookup is
# arch-consistent.
MatchPattern=mybox_@v_%a.raw

[Target]
# Versioned filename keeps InstancesMax=2 side-by-side for rollback.
# No CurrentSymlink= — operators validate a new version under its
# instance name before retargeting the mybox.raw symlink themselves.
Type=regular-file
Path=/var/lib/machines
MatchPattern=mybox_@v.raw
InstancesMax=2
