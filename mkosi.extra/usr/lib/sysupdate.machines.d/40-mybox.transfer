[Transfer]
# Opt-in mybox nspawn DDI update: replaces the single sealed verity-erofs
# .raw wholesale. Separate sysupdate.machines.d/ prefix (not
# extensions.d/) because the post-update verb is machinectl restart, not
# sysext refresh — keeps just recipes from mixing the two. Enable via
# /etc/sysupdate.machines.d/mybox.feature.d/enable.conf.
Features=mybox

[Source]
# Populated by `myosi fetch` from the GitHub release. %a matches mkosi's
# Output=%i_%v_%a stamp, so the lookup is arch-consistent.
Type=regular-file
Path=/var/lib/sysupdate
MatchPattern=mybox_@v_%a.raw

[Target]
# Versioned filename keeps InstancesMax=2 side-by-side for rollback.
# No CurrentSymlink= — operators validate a new version under its
# instance name before retargeting the mybox.raw symlink themselves.
Type=regular-file
Path=/var/lib/machines
MatchPattern=mybox_@v.raw
InstancesMax=2
