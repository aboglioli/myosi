# Game controller access for Steam Input, equivalent to Valve's steam-devices.
# systemd's 70-uaccess.rules only tags input/joystick evdev nodes, so native
# SDL games work while Steam cannot open the raw HID node or create its virtual
# gamepad. Without these two grants Steam Input silently produces no input.

# /dev/uinput is a static node: the module is absent until something opens it,
# so there is no add event for uaccess to act on and the group grant is needed.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"

# Sony DualSense (PS5) over USB
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
# Sony DualSense (PS5) over Bluetooth
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
