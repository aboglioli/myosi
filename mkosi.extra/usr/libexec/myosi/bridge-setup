#!/usr/bin/env bash
#
# LAN bridge management. Guests attached to the bridge — libvirt, podman,
# incus — are peers on the physical LAN. Lives in the base image because a
# containers-only host wants the same link. Idempotent.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
. "${SCRIPT_DIR}/lib.sh"

BRIDGE=br0
IFACE=""
VERB=""

usage() {
    cat >&2 <<'EOF'
Usage: /usr/libexec/myosi/bridge-setup <create|status|delete> [options]

  create   Create the bridge and enslave a physical iface.
  status   Report the bridge, its slaves, and its address.
  delete   Remove the bridge and return the iface to a plain connection.

Options:
  --iface=<iface>   Physical iface to enslave. Default: default route.
  --name=<bridge>   Bridge name. Default: br0.
EOF
}

for arg in "$@"; do
    case "$arg" in
        create|status|delete) VERB="$arg" ;;
        --iface=*)  IFACE="${arg#*=}" ;;
        --name=*)   BRIDGE="${arg#*=}" ;;
        -h|--help)  usage; exit 0 ;;
        *) echo "ERROR: unknown arg: $arg" >&2; usage; exit 2 ;;
    esac
done

if [ -z "$VERB" ]; then
    usage
    exit 2
fi

validate_name "$BRIDGE" bridge

# Single-pass awk, no `exit`: an early exit SIGPIPEs the writer under pipefail.
detect_iface() {
    ip -4 route show default 2>/dev/null | awk '!f {print $5; f=1}' || true
}

active_connection() {
    nmcli -t -f NAME,DEVICE con show --active 2>/dev/null \
        | awk -F: -v d="$1" '$2 == d && !f {print $1; f=1}' || true
}

bridge_slaves() {
    find "/sys/class/net/$BRIDGE/brif" -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null || true
}

do_status() {
    if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
        echo "Bridge $BRIDGE does not exist."
        echo "Create it with: sudo myosi bridge-create"
        return 0
    fi

    echo "Bridge:  $BRIDGE"
    local slaves
    slaves=$(bridge_slaves | paste -sd' ' -)
    echo "Slaves:  ${slaves:-<none — the bridge has no uplink>}"
    ip -br addr show "$BRIDGE"

    if [ -z "$slaves" ]; then
        echo
        echo "WARN: $BRIDGE has no enslaved iface — attached guests reach nothing." >&2
    fi

    # libvirt loads br_netfilter, which pushes bridged frames through nftables.
    local nf=/proc/sys/net/bridge/bridge-nf-call-iptables
    if [ -r "$nf" ] && [ "$(cat "$nf")" != 0 ]; then
        echo
        echo "WARN: bridge-nf-call-iptables=1 — bridged frames traverse nftables." >&2
        echo "      Set it to 0 if attached guests lose traffic to the LAN." >&2
    fi
}

do_create() {
    if ip link show "$BRIDGE" >/dev/null 2>&1; then
        echo "Bridge $BRIDGE already exists."
        return 0
    fi

    if [ -z "$IFACE" ]; then
        IFACE=$(detect_iface)
    fi
    if [ -z "$IFACE" ] || ! ip link show "$IFACE" >/dev/null 2>&1; then
        echo "ERROR: no usable iface (got '${IFACE:-none}'). Pass --iface=." >&2
        ip -br link | awk '$1 != "lo" {print "  " $1}' >&2
        exit 3
    fi
    # A station-mode 802.11 link drops frames whose source MAC is not its own.
    if [ -e "/sys/class/net/$IFACE/wireless" ] || [ -e "/sys/class/net/$IFACE/phy80211" ]; then
        echo "ERROR: $IFACE is wireless; a WiFi station cannot be bridged." >&2
        exit 3
    fi

    # Inherit the slave's MAC so the host keeps its DHCP reservation.
    local mac old
    mac=$(cat "/sys/class/net/$IFACE/address")
    old=$(active_connection "$IFACE")

    if [ -n "${SSH_CONNECTION:-}" ]; then
        echo "NOTE: over SSH — $IFACE drops for 5-30 s while $BRIDGE takes over."
    fi

    # A failure past here leaves a headless host with no way back in.
    restore() {
        nmcli con delete "$BRIDGE" "$BRIDGE-$IFACE" >/dev/null 2>&1 || true
        [ -n "$old" ] && nmcli con up "$old" >/dev/null 2>&1 || true
    }
    trap restore EXIT

    echo "Creating $BRIDGE with $IFACE as slave..."
    nmcli con add type bridge ifname "$BRIDGE" con-name "$BRIDGE" \
        bridge.stp no bridge.mac-address "$mac" \
        ipv4.method auto ipv6.method auto
    nmcli con add type ethernet ifname "$IFACE" master "$BRIDGE" con-name "$BRIDGE-$IFACE"
    [ -n "$old" ] && nmcli con down "$old" >/dev/null 2>&1 || true
    nmcli con up "$BRIDGE"
    nmcli con up "$BRIDGE-$IFACE"

    trap - EXIT
    ip -br addr show "$BRIDGE"
}

do_delete() {
    if ! nmcli -t -f NAME con show 2>/dev/null | grep -qx "$BRIDGE"; then
        echo "No NetworkManager connection named $BRIDGE — nothing to delete."
        return 0
    fi

    # Read the slave first — the brif dir goes away with the bridge connection.
    local slave
    slave=$(bridge_slaves | awk '!f {print; f=1}')

    if [ -n "${SSH_CONNECTION:-}" ]; then
        echo "NOTE: over SSH — the link drops while ${slave:-the iface} takes the address back."
    fi

    echo "Deleting $BRIDGE..."
    nmcli con delete "$BRIDGE" >/dev/null 2>&1 || true
    nmcli con delete "$BRIDGE-$slave" >/dev/null 2>&1 || true

    if [ -z "$slave" ]; then
        echo "WARN: $BRIDGE had no slave; no iface to restore." >&2
        return 0
    fi

    # Reuse an existing profile if one claims the iface; synthesize one only
    # when nothing does, which would otherwise strand a headless host.
    local prev
    prev=$(nmcli -t -f NAME,DEVICE con show 2>/dev/null \
           | awk -F: -v d="$slave" '$2 == d && !f {print $1; f=1}') || true
    if [ -n "$prev" ]; then
        nmcli con up "$prev"
    else
        nmcli con add type ethernet ifname "$slave" con-name "$slave" \
            ipv4.method auto ipv6.method auto
        nmcli con up "$slave"
    fi
    ip -br addr show "$slave"
}

case "$VERB" in
    status) do_status ;;
    create) require_root; do_create ;;
    delete) require_root; do_delete ;;
esac
