#!/usr/bin/env bash
# Stack a tmpfs-upper overlay on /usr/lib/modules/<KVER>/ and run depmod so
# module indices include merged sysexts' extra/<sysext>/ modules.
# Needed because mkosi v26's sysext sealer strips any path that also exists
# in the base tree regardless of content — the regenerated modules.dep etc.
# get unlinked at seal time, so `modprobe nvidia` fails despite the .ko being
# present. depmod can't write in place: /usr and the sysext overlay are ro.

set -euo pipefail

KVER=$(uname -r)
MODDIR="/usr/lib/modules/${KVER}"
STATE="/run/myosi/depmod"
UPPER="${STATE}/${KVER}/upper"
WORK="${STATE}/${KVER}/work"

if [ ! -d "$MODDIR" ]; then
    echo "ERROR: $MODDIR not found — no kernel modules tree to refresh" >&2
    exit 1
fi

if [ "$EUID" -ne 0 ]; then
    echo "ERROR: must run as root" >&2
    exit 1
fi

# Re-stack with a fresh upper so state matches the current merged sysext set.
if mountpoint -q "$MODDIR"; then
    umount "$MODDIR" || {
        echo "WARN: existing overlay on $MODDIR busy; depmod refresh may use stale upper" >&2
    }
fi

mkdir -p "$UPPER" "$WORK"

# Stacking an overlay on a subdir of the existing /usr overlay works on F44+.
mount -t overlay overlay \
    -o "lowerdir=${MODDIR},upperdir=${UPPER},workdir=${WORK}" \
    "$MODDIR"

# If depmod fails, the empty upper would shadow modules.dep and break
# modprobe for EVERY module — unmount on failure so the verity-resident
# indices stay visible.
trap 'umount "$MODDIR" 2>/dev/null || true' ERR

depmod -a "$KVER"

trap - ERR
echo "Refreshed depmod indices for ${KVER} (overlay upper at ${UPPER})"

# Load modules-load.d modules HERE, not via systemd-modules-load: a fresh
# systemd-modules-load run right after this script race-loses against overlay
# dentry-cache invalidation and reports "Failed to find module 'nvidia'"
# (observed in journal) even though modprobe works immediately afterwards.
# Replicate its precedence: /etc > /run > /usr/lib, last file per basename wins.
declare -A modload_cfgs
for dir in /usr/lib/modules-load.d /run/modules-load.d /etc/modules-load.d; do
    [ -d "$dir" ] || continue
    for cfg in "$dir"/*.conf; do
        [ -e "$cfg" ] || continue
        modload_cfgs[$(basename "$cfg")]=$cfg
    done
done

for cfg in "${modload_cfgs[@]}"; do
    while IFS= read -r raw; do
        # Strip inline #/; comments, take the first token.
        stripped=${raw%%[#;]*}
        read -r mod _ <<< "$stripped" || true
        [ -n "$mod" ] || continue
        modprobe -q "$mod" 2>/dev/null || \
            echo "sysext-modules-refresh: failed to load ${mod}" >&2
    done < "$cfg"
done
