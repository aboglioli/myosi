#!/usr/bin/env bash
# Symlink verity-baked sysexts from /usr/share/myosi/extensions/ into
# /var/lib/extensions/ — systemd-sysext only scans /etc, /run and /var/lib
# extensions dirs (verified on F44 systemd 259), and /var/lib is mutable so
# raws can't be baked there; symlink targets stay verity-immutable so image
# upgrade rotates content atomically. Manages SYMLINKS only — operator-dropped
# regular files are never touched. Idempotent (sysext ExecStartPre, every boot).

set -euo pipefail

SRC_DIR=/usr/share/myosi/extensions
TGT_DIR=/var/lib/extensions

[ -d "$SRC_DIR" ] || exit 0

mkdir -p "$TGT_DIR"

# <name>_<VERSION>.raw → <name> (version is the last "_" component).
extract_name() {
    local fn=${1##*/}
    fn=${fn%.raw}
    echo "${fn%_*}"
}

shopt -s nullglob

# Build map: baked_name -> baked_filename
declare -A baked
for src in "$SRC_DIR"/*.raw; do
    name=$(extract_name "$src")
    baked[$name]=$(basename "$src")
done

# Remove stale SYMLINKS only: (a) name matches the current bake but version
# differs — sysext would merge BOTH versions (it does no version selection);
# (b) dangling link into $SRC_DIR (name no longer baked). Regular files are
# operator overrides and are NEVER deleted.
for tgt in "$TGT_DIR"/*.raw; do
    [ -L "$tgt" ] || continue
    fn=$(basename "$tgt")
    name=$(extract_name "$tgt")
    link_target=$(readlink "$tgt")

    # Only manage symlinks pointing into $SRC_DIR.
    case "$link_target" in
        "$SRC_DIR"/*) ;;
        *) continue ;;
    esac

    # (a) name matches a current bake but filename differs
    if [ -n "${baked[$name]:-}" ] && [ "$fn" != "${baked[$name]}" ]; then
        echo "sysext-baked-sync: removing stale symlink ${fn} (baked now: ${baked[$name]})"
        rm -f "$tgt"
        continue
    fi

    # (b) dangling baseline symlink (we stopped baking this name)
    if [ ! -e "$link_target" ]; then
        echo "sysext-baked-sync: removing dangling symlink ${fn} -> ${link_target}"
        rm -f "$tgt"
    fi
done

# Link current bakes into the discovery path; never overwrite a regular file.
for name in "${!baked[@]}"; do
    fn=${baked[$name]}
    src="$SRC_DIR/$fn"
    tgt="$TGT_DIR/$fn"

    if [ -L "$tgt" ]; then
        if [ "$(readlink "$tgt")" = "$src" ]; then
            continue
        fi
        ln -sf "$src" "$tgt"
    elif [ -e "$tgt" ]; then
        echo "sysext-baked-sync: $tgt is a regular file, leaving alone (operator override)" >&2
    else
        ln -s "$src" "$tgt"
        echo "sysext-baked-sync: linked ${fn} -> ${src}"
    fi
done
