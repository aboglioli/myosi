#!/usr/bin/env bash
# Record a checksum manifest of the verity-baked factory /etc tree, once
# per IMAGE_VERSION. `myosi etc-drift` diffs the previous manifest against
# the current one to answer the question a plain `diff /etc
# /usr/share/factory/etc` cannot: which files did the IMAGE change in this
# upgrade that your overlay upper is now shadowing? After a sysupdate the
# previous image's factory tree is gone (it lives in the other A/B slot's
# /usr), so the answer has to be recorded before it disappears.
set -euo pipefail

FACTORY="${MYOSI_FACTORY:-/usr/share/factory/etc}"
DIR="${MYOSI_MANIFEST_DIR:-/var/lib/myosi/etc-manifests}"
KEEP=2

version="${MYOSI_IMAGE_VERSION:-}"
if [ -z "$version" ]; then
    version=$(awk -F= '$1=="IMAGE_VERSION"{gsub(/^"|"$/,"",$2);print $2;exit}' \
        /usr/lib/os-release /etc/os-release 2>/dev/null | head -1)
fi
[ -n "$version" ] || version=unknown

target="$DIR/${version}.sha256"
[ -e "$target" ] && exit 0          # already recorded for this image
[ -d "$FACTORY" ] || exit 0

mkdir -p "$DIR"
# Relative paths so the manifest is comparable across image versions.
( cd "$FACTORY" && find . -type f -printf '%P\0' | sort -z \
    | xargs -0 -r sha256sum ) > "$target.tmp"
mv "$target.tmp" "$target"
echo "etc-manifest: recorded $(wc -l < "$target") factory entries for $version"

# Keep only the current + previous generation, mirroring InstancesMax=2 on
# the sysupdate store.
ls -1t "$DIR"/*.sha256 2>/dev/null | tail -n "+$((KEEP+1))" | while read -r old; do
    rm -f "$old"
done
