#!/usr/bin/env bash
# Provision a homed user: create record + LUKS home, bind sysext groups,
# allocate subuid/subgid. Runs as myosi-homed-user@<name>.service and again
# after a live sysext refresh. Idempotent.
#
# Only creation needs an identity file — groups and subids are applied to any
# existing user, so a user made by hand with `homectl create` is covered too.
#
# Not homed's ExecStartPost: homed is Type=notify and signals READY=1 first,
# which would mask failures here.

set -euo pipefail

NAME=${1:?usage: homed-user-provision <username>}
DROP_DIR=/usr/share/myosi/user-groups.d
BOOTSTRAP_PASSWORD="${MYOSI_BOOTSTRAP_PASSWORD:-changeme}"

# /etc first: operator-writable and survives A/B updates, unlike baked /usr.
IDENTITY=
for candidate in "/etc/myosi/users/${NAME}.user" "/usr/share/myosi/users/${NAME}.user"; do
    if [ -f "$candidate" ]; then
        IDENTITY="$candidate"
        break
    fi
done

# PASSWORD/NEWPASSWORD: homed 259 ignores --identity=' secret section (fixed in
# 260+); homectl honours these env vars instead.
# defcontext=: homectl doesn't label inside the LUKS image, and unlabeled_t
# makes SELinux deny sudo/sshd/keyring.
# --luks-offline-discard=no: the default shrinks the stack on logout, and homed
# SIGKILLs the worker 30 s into shutdown — an interrupted shrink leaves btrfs
# small inside a full-size LUKS device that the next boot never regrows.
RECORD_UID=$([ -n "$IDENTITY" ] && jq -r '.uid // empty' "$IDENTITY" 2>/dev/null || true)
if [ -n "$RECORD_UID" ] && ! homectl inspect "$NAME" >/dev/null 2>&1; then
    # No pipeline: getent exits 2 on an unused uid, and pipefail turned that
    # into an abort before the user was ever created.
    EXISTING=
    if passwd_entry=$(getent passwd "$RECORD_UID" 2>/dev/null); then
        EXISTING=${passwd_entry%%:*}
    fi
    if [ -n "$EXISTING" ] && [ "$EXISTING" != "$NAME" ]; then
        # Retarget rather than bail, or a host with its own primary user never
        # gets groups bound. Clearing IDENTITY skips creation: the uid is taken.
        echo "homed-user-provision: uid ${RECORD_UID} owned by '${EXISTING}', not '${NAME}' — binding groups to '${EXISTING}'" >&2
        NAME="$EXISTING"
        IDENTITY=
    fi
fi

if [ -n "$IDENTITY" ] && ! homectl inspect "$NAME" >/dev/null 2>&1; then
    echo "homed-user-provision: creating homed record for '$NAME' from $IDENTITY" >&2
    PASSWORD="$BOOTSTRAP_PASSWORD" NEWPASSWORD="$BOOTSTRAP_PASSWORD" \
        homectl create "$NAME" \
            --identity="$IDENTITY" \
            --storage=luks \
            --disk-size=53687091200 \
            --fs-type=btrfs \
            --luks-discard=yes \
            --luks-offline-discard=no \
            --luks-extra-mount-options=defcontext=system_u:object_r:user_home_dir_t:s0 \
            --password-hint="Default password: ${BOOTSTRAP_PASSWORD} — change with 'homectl passwd ${NAME}'"
fi

if ! homectl inspect "$NAME" >/dev/null 2>&1; then
    if [ -n "$IDENTITY" ]; then
        echo "homed-user-provision: '$NAME' still absent after creation, not binding groups" >&2
    else
        echo "homed-user-provision: no identity for '$NAME' and no such homed user — create it first ('homectl create $NAME --uid=1000 ...'), nothing to do" >&2
    fi
    exit 0
fi

# Scoped `if`, not `|| exit 0`: subid allocation below must still run on a host
# whose sysexts declare no groups.
if [ -d "$DROP_DIR" ]; then
    declare -A wanted
    shopt -s nullglob
    for cfg in "$DROP_DIR"/*.conf; do
        while IFS= read -r raw || [ -n "$raw" ]; do
            stripped=${raw%%#*}
            read -r group _ <<< "$stripped" || true
            [ -n "${group:-}" ] || continue
            wanted[$group]=1
        done < "$cfg"
    done

    for group in "${!wanted[@]}"; do
        # Missing means the declaring sysext's sysusers.d hasn't run; the next
        # trigger retries.
        if ! getent group "$group" >/dev/null 2>&1; then
            continue
        fi
        # Pure-bash membership test; a grep -q pipeline can SIGPIPE under pipefail.
        case " $(id -nG "$NAME" 2>/dev/null) " in
            *" $group "*) ;;
            *)
                gpasswd -a "$NAME" "$group" >/dev/null
                echo "homed-user-provision: added ${NAME} to ${group}" >&2
                ;;
        esac
    done
fi

# Rootless podman/distrobox/incus read subuid/subgid directly; a homed record
# has no field feeding them and `usermod --add-subuids` refuses homed users.
SUBID_COUNT=1000000
SUBID_FLOOR=100000
SUBID_CEILING=4294967295   # uid_t max

subid_ensure() {
    local file="$1"

    if [ ! -e "$file" ]; then
        : > "$file" || { echo "homed-user-provision: cannot create $file" >&2; return 0; }
        # restorecon warns on stdout, which would reach journal+console.
        command -v restorecon >/dev/null 2>&1 && restorecon "$file" >/dev/null 2>&1 || true
    fi

    local -a ranges=()
    local n s c
    while IFS=: read -r n s c || [ -n "${n:-}" ]; do
        # An existing entry wins whatever its size — operator intent.
        if [ "${n:-}" = "$NAME" ]; then
            return 0
        fi
        case "${s:-}${c:-}" in *[!0-9]*|"") continue ;; esac
        [ "$c" -gt 0 ] || continue
        ranges+=("$s $((s + c))")
    done < "$file"

    # Walk sorted ranges for the first gap instead of appending past the highest
    # end: on a pre-existing file a custom `root:0:4294967295` would otherwise
    # push the allocation off the id space.
    local cand=$SUBID_FLOOR rs re
    while read -r rs re; do
        [ -n "${rs:-}" ] || continue
        if [ $((cand + SUBID_COUNT)) -le "$rs" ]; then
            break
        fi
        if [ "$re" -gt "$cand" ]; then
            cand=$re
        fi
    done < <(printf '%s\n' "${ranges[@]:-}" | sort -n)

    if [ "$cand" -gt $((SUBID_CEILING - SUBID_COUNT)) ]; then
        echo "homed-user-provision: no free ${SUBID_COUNT}-wide range in $file, leaving it to the operator" >&2
        return 0
    fi

    # Non-fatal: groups are already bound, don't fail the unit over this.
    if ! printf '%s:%s:%s\n' "$NAME" "$cand" "$SUBID_COUNT" >> "$file"; then
        echo "homed-user-provision: cannot write $file" >&2
        return 0
    fi
    echo "homed-user-provision: allocated ${file##*/} range ${cand}:${SUBID_COUNT} for ${NAME}" >&2
}

# Instances can start in parallel at boot and would pick the same gap. Braces
# keep 2>/dev/null off the shell's own stderr — bare `exec ... 2>/dev/null`
# redirects it permanently.
if { exec 9>/run/lock/myosi-subid.lock; } 2>/dev/null; then
    flock 9 2>/dev/null || true
fi

subid_ensure /etc/subuid
subid_ensure /etc/subgid
