#!/usr/bin/env bash
# Provision a homed-managed user from /usr/share/myosi/users/<name>.user,
# then bind it to groups declared under /usr/share/myosi/user-groups.d/.
# Runs as templated myosi-homed-user@<name>.service — NOT homed
# ExecStartPost: homed is Type=notify and sends READY=1 before ExecStartPost,
# masking provisioning failures (and hiding them from the console).
# Re-triggered after live sysext refresh to bind new groups. Idempotent.

set -euo pipefail

NAME=${1:?usage: homed-user-provision <username>}
IDENTITY=/usr/share/myosi/users/${NAME}.user
DROP_DIR=/usr/share/myosi/user-groups.d
BOOTSTRAP_PASSWORD="${MYOSI_BOOTSTRAP_PASSWORD:-changeme}"

if [ ! -f "$IDENTITY" ]; then
    echo "homed-user-provision: no identity at $IDENTITY, nothing to do" >&2
    exit 0
fi

# Phase 1 — create user record + LUKS-backed home if missing.
# PASSWORD/NEWPASSWORD env: homed 259 (F44) ignores the secret section of
# --identity= (fixed in 260+); homectl honors these env vars instead.
# Operator rotates via `homectl passwd`.
# defcontext=: homectl doesn't label the fs inside the LUKS image — without
# it everything mounts unlabeled_t and SELinux denies sudo, sshd
# authorized_keys, keyring (https://discussion.fedoraproject.org/t/72690).
# --luks-offline-discard=no: the default (yes) shrinks the whole stack on
# logout and regrows it on login. homed SIGKILLs the worker 30 s into
# shutdown, which leaves btrfs shrunk inside a still-full-size LUKS device;
# the next boot's grow path only compares image size vs. diskSize, sees a
# match, and never regrows btrfs — so the home stays small until someone runs
# `btrfs filesystem resize max`. Online discard already reclaims space, so
# the logout shrink gains nothing.
# Skip when the record's UID already belongs to another user — hosts
# that provision their own primary user don't want the default one.
RECORD_UID=$(jq -r '.uid // empty' "$IDENTITY" 2>/dev/null)
if [ -n "$RECORD_UID" ] && ! homectl inspect "$NAME" >/dev/null 2>&1; then
    EXISTING=$(getent passwd "$RECORD_UID" | cut -d: -f1)
    if [ -n "$EXISTING" ] && [ "$EXISTING" != "$NAME" ]; then
        echo "homed-user-provision: uid ${RECORD_UID} already owned by '${EXISTING}', skipping '$NAME'" >&2
        exit 0
    fi
fi

if ! homectl inspect "$NAME" >/dev/null 2>&1; then
    echo "homed-user-provision: creating homed record for '$NAME' from $IDENTITY" >&2
    PASSWORD="$BOOTSTRAP_PASSWORD" NEWPASSWORD="$BOOTSTRAP_PASSWORD" \
        homectl create "$NAME" \
            --identity="$IDENTITY" \
            --storage=luks \
            --disk-size=53687091200 \
            --fs-type=btrfs \
            --luks-discard=yes \
            --luks-offline-discard=no \
            --luks-extra-mount-options=defcontext=system_u:object_r:user_home_dir_t:s0 \
            --password-hint="Default password: ${BOOTSTRAP_PASSWORD} — change with 'homectl passwd ${NAME}'"
fi

# Phase 2 — bind user to groups declared by active sysexts / profile
# features. Drop-ins ship from each feature's mkosi.extra AND its sysext
# sub-image (same source tree via ExtraTrees), so both bake paths see them.
[ -d "$DROP_DIR" ] || exit 0

declare -A wanted
shopt -s nullglob
for cfg in "$DROP_DIR"/*.conf; do
    while IFS= read -r raw || [ -n "$raw" ]; do
        stripped=${raw%%#*}
        read -r group _ <<< "$stripped" || true
        [ -n "${group:-}" ] || continue
        wanted[$group]=1
    done < "$cfg"
done

for group in "${!wanted[@]}"; do
    if ! getent group "$group" >/dev/null 2>&1; then
        # Group not in NSS yet (declaring sysext's sysusers.d may not have
        # run). Skip silently; next trigger retries.
        continue
    fi
    # Pure-bash membership check; a grep -q pipeline can SIGPIPE its
    # producer under pipefail.
    case " $(id -nG "$NAME" 2>/dev/null) " in
        *" $group "*) ;;
        *)
            gpasswd -a "$NAME" "$group" >/dev/null
            echo "homed-user-provision: added ${NAME} to ${group}" >&2
            ;;
    esac
done
