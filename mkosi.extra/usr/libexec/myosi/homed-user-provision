#!/usr/bin/env bash
# Provision a homed-managed user from <name>.user, then bind it to groups
# declared under /usr/share/myosi/user-groups.d/.
# Runs as templated myosi-homed-user@<name>.service — NOT homed
# ExecStartPost: homed is Type=notify and sends READY=1 before ExecStartPost,
# masking provisioning failures (and hiding them from the console).
# Re-triggered after live sysext refresh to bind new groups. Idempotent.
#
# Two supported shapes, both ending in a group-bound user:
#   declarative — drop <name>.user in /etc/myosi/users (post-install, no
#                 rebuild) or bake it at /usr/share/myosi/users; phase 1
#                 creates the record, phase 2 binds groups.
#   manual      — operator runs `homectl create` by hand (the documented
#                 first-boot path, since the image ships no user and /usr is
#                 read-only erofs so no identity can be added there). There is
#                 no identity file at all: phase 1 is skipped, phase 2 still
#                 runs. This is why the identity is NOT a hard precondition —
#                 bailing early here left operator-created users permanently
#                 unbound from sysext groups.

set -euo pipefail

NAME=${1:?usage: homed-user-provision <username>}
DROP_DIR=/usr/share/myosi/user-groups.d
BOOTSTRAP_PASSWORD="${MYOSI_BOOTSTRAP_PASSWORD:-changeme}"

# Identity search path: writable /etc first — it is operator-authorable
# post-install and persists across A/B image updates — then the baked image
# default. Empty means "manual shape", handled above.
IDENTITY=
for candidate in "/etc/myosi/users/${NAME}.user" "/usr/share/myosi/users/${NAME}.user"; do
    if [ -f "$candidate" ]; then
        IDENTITY="$candidate"
        break
    fi
done

# Phase 1 — create user record + LUKS-backed home if missing.
# PASSWORD/NEWPASSWORD env: homed 259 (F44) ignores the secret section of
# --identity= (fixed in 260+); homectl honors these env vars instead.
# Operator rotates via `homectl passwd`.
# defcontext=: homectl doesn't label the fs inside the LUKS image — without
# it everything mounts unlabeled_t and SELinux denies sudo, sshd
# authorized_keys, keyring (https://discussion.fedoraproject.org/t/72690).
# --luks-offline-discard=no: the default (yes) shrinks the whole stack on
# logout and regrows it on login. homed SIGKILLs the worker 30 s into
# shutdown, which leaves btrfs shrunk inside a still-full-size LUKS device;
# the next boot's grow path only compares image size vs. diskSize, sees a
# match, and never regrows btrfs — so the home stays small until someone runs
# `btrfs filesystem resize max`. Online discard already reclaims space, so
# the logout shrink gains nothing.
# Skip when the record's UID already belongs to another user — hosts
# that provision their own primary user don't want the default one.
RECORD_UID=$([ -n "$IDENTITY" ] && jq -r '.uid // empty' "$IDENTITY" 2>/dev/null || true)
if [ -n "$RECORD_UID" ] && ! homectl inspect "$NAME" >/dev/null 2>&1; then
    # No pipeline here. `getent passwd <uid>` exits 2 when the UID is unused —
    # the normal fresh-install case — and under `set -o pipefail` that status
    # propagates through the pipe to the assignment, so `set -e` killed the
    # script BEFORE it created the user. Same class of bug as the phase-2
    # `grep -q` note below; keep both pure-bash.
    EXISTING=
    if passwd_entry=$(getent passwd "$RECORD_UID" 2>/dev/null); then
        EXISTING=${passwd_entry%%:*}
    fi
    if [ -n "$EXISTING" ] && [ "$EXISTING" != "$NAME" ]; then
        # Retarget instead of bailing out: skipping the whole script also
        # skipped phase 2, so a host that provisioned its own primary user
        # (the documented escape hatch, and any pre-genericisation install)
        # silently never got bound to sysext-declared groups — new drop-ins
        # just never applied. Rebinding NAME keeps creation gated (the
        # homectl inspect below now succeeds) while phase 2 runs against the
        # user that actually owns the UID.
        echo "homed-user-provision: uid ${RECORD_UID} owned by '${EXISTING}', not '${NAME}' — binding groups to '${EXISTING}'" >&2
        NAME="$EXISTING"
        # Clearing IDENTITY drops us into the "manual shape": phase 1 is
        # skipped, phase 2 binds. The UID is demonstrably taken, so creation
        # is never right here — and without this, a UID 1000 owned by a
        # NON-homed user would send `homectl create <them>` an identity file
        # whose userName is somebody else.
        IDENTITY=
    fi
fi

if [ -n "$IDENTITY" ] && ! homectl inspect "$NAME" >/dev/null 2>&1; then
    echo "homed-user-provision: creating homed record for '$NAME' from $IDENTITY" >&2
    PASSWORD="$BOOTSTRAP_PASSWORD" NEWPASSWORD="$BOOTSTRAP_PASSWORD" \
        homectl create "$NAME" \
            --identity="$IDENTITY" \
            --storage=luks \
            --disk-size=53687091200 \
            --fs-type=btrfs \
            --luks-discard=yes \
            --luks-offline-discard=no \
            --luks-extra-mount-options=defcontext=system_u:object_r:user_home_dir_t:s0 \
            --password-hint="Default password: ${BOOTSTRAP_PASSWORD} — change with 'homectl passwd ${NAME}'"
fi

# Phase 2 — bind user to groups declared by active sysexts / profile
# features. Drop-ins ship from each feature's mkosi.extra AND its sysext
# sub-image (same source tree via ExtraTrees), so both bake paths see them.
#
# Gate on the user EXISTING, not on an identity file: the manual shape has no
# identity, and this is the only thing that keeps an operator-created user in
# sync with sysext groups.
if ! homectl inspect "$NAME" >/dev/null 2>&1; then
    if [ -n "$IDENTITY" ]; then
        echo "homed-user-provision: '$NAME' still absent after phase 1, not binding groups" >&2
    else
        echo "homed-user-provision: no identity for '$NAME' and no such homed user — create it first ('homectl create $NAME --uid=1000 ...'), nothing to do" >&2
    fi
    exit 0
fi

[ -d "$DROP_DIR" ] || exit 0

declare -A wanted
shopt -s nullglob
for cfg in "$DROP_DIR"/*.conf; do
    while IFS= read -r raw || [ -n "$raw" ]; do
        stripped=${raw%%#*}
        read -r group _ <<< "$stripped" || true
        [ -n "${group:-}" ] || continue
        wanted[$group]=1
    done < "$cfg"
done

for group in "${!wanted[@]}"; do
    if ! getent group "$group" >/dev/null 2>&1; then
        # Group not in NSS yet (declaring sysext's sysusers.d may not have
        # run). Skip silently; next trigger retries.
        continue
    fi
    # Pure-bash membership check; a grep -q pipeline can SIGPIPE its
    # producer under pipefail.
    case " $(id -nG "$NAME" 2>/dev/null) " in
        *" $group "*) ;;
        *)
            gpasswd -a "$NAME" "$group" >/dev/null
            echo "homed-user-provision: added ${NAME} to ${group}" >&2
            ;;
    esac
done
