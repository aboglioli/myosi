#!/usr/bin/env bash
# myosi — operator entry point for myosi host management.
#
# Builds a transient justfile at /run/myosi/justfile each invocation by
# importing every *.just module under /usr/share/myosi/just/. The base
# image ships 00-update / 10-extensions / 11-machines / 40-install in
# that directory. Sysexts (virt, desktop, ...) can drop
# their own NN-<name>.just into the SAME directory via their mkosi.extra
# tree — the file appears at /usr/share/myosi/just/ exactly when the
# sysext is merged into /usr/, and disappears when it isn't. The wrapper
# discovers it via the directory scan, so the base never has to know any
# sysext name in advance.
#
# Recipe-to-recipe internal calls (00-update.just `run` calls its own
# fetch + apply, 10-extensions.just `extension-enable` calls
# 00-update.just `run`) reference the target module directly:
#     just -f /usr/share/myosi/just/00-update.just <recipe> ...
# That keeps base recipes independent of any sysext being merged — they
# only see their own module, not the dynamic dispatch file built here.
#
# Convention for slot numbers:
#   00-49  base modules (always present)
#   50-99  sysext-provided modules
#
# Usage: myosi <command> [args...]
#        myosi --list

set -euo pipefail

JUST_DIR="${MYOSI_JUST_DIR:-/usr/share/myosi/just}"
RUN_JUSTFILE="${MYOSI_RUN_JUSTFILE:-/run/myosi/justfile}"

if [ ! -d "$JUST_DIR" ]; then
    echo "ERROR: $JUST_DIR not found" >&2
    exit 1
fi

mkdir -p "$(dirname "$RUN_JUSTFILE")"

# Build /run/myosi/justfile by scanning the just module directory. Sort
# by basename keeps the order deterministic across invocations and gives
# base modules (00-49) a stable spot above sysext modules (50+).
{
    printf '# Auto-generated by /usr/local/bin/myosi. Do not edit.\n'
    printf '# Scanned: %s\n\n' "$JUST_DIR"
    printf 'default:\n    @just -f "%s" --list --unsorted\n\n' "$RUN_JUSTFILE"
    find "$JUST_DIR" -maxdepth 1 -type f -name '*.just' \
        | sort \
        | while IFS= read -r f; do printf 'import "%s"\n' "$f"; done
} > "$RUN_JUSTFILE"

if [ "${1:-}" = "--list" ] || [ "${1:-}" = "-l" ] || [ -z "${1:-}" ]; then
    exec just -f "$RUN_JUSTFILE" --list --unsorted
fi

exec just -f "$RUN_JUSTFILE" "$@"
