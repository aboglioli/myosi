# Factory-tree /etc/shadow, copied into the /etc subvol on first boot by
# tmpfiles C!; later passwd edits persist across image upgrades.
# root ships LOCKED — first access is SSH publickey as the default user
# (NOPASSWD wheel sudo); `sudo passwd root` to unlock, or override this
# file via mkosi.local.conf ExtraTrees= for a bootstrap hash.
# Interactive users are owned by systemd-homed, not seeded here.
root:!:0:99999:7:::
