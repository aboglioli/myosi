# /etc/shadow shipped in the verity-baked /usr/share/factory/etc factory
# tree; tmpfiles' `C!` rule copies it into the /etc subvol on first boot,
# and later `passwd` edits persist there across image upgrades.
#
# root ships LOCKED. First access is an SSH publickey login as the
# default user (NOPASSWD wheel sudo); unlock root afterwards with
# `sudo passwd root` if you want direct root logins. To ship a
# bootstrap root hash instead (e.g. serial-console debugging during
# install validation), override this file via a private
# mkosi.local.conf ExtraTrees= overlay.
#
# Interactive users are NOT seeded here — they are owned by
# systemd-homed (see /usr/share/myosi/users/ + myosi-homed-user@).
root:!:0:99999:7:::
