#!/usr/bin/env bash
# Build NVIDIA-580xx legacy sysext — proprietary kmod for Maxwell /
# Pascal / Volta. Logic shared with the nvidia sibling in
# mkosi.shared/nvidia-build.sh; this wrapper only selects the branch.

set -euo pipefail

STAGE="${1:-final}"
[ "$STAGE" = "final" ] || exit 0

export NVIDIA_BRANCH=580xx
export NVIDIA_BUILD_OPTIONAL=1
source "${SRCDIR}/mkosi.shared/nvidia-build.sh"
