#!/usr/bin/env bash
set -euo pipefail

. "${SRCDIR}/mkosi.shared/sysext-build.sh"
[ "${1:-final}" = "final" ] || exit 0

# Unit activation is declarative — static .wants/ symlinks in the
# profile's mkosi.extra cover both baked and sysext delivery.
# SELinux: container-selinux is in base policy; baked xattrs resolve at
# sysext merge, no runtime semodule.

sysext_write_extension_release containers

sysext_finalize "$@"
