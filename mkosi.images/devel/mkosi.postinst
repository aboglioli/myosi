#!/usr/bin/env bash
set -euo pipefail

. "${SRCDIR}/mkosi.shared/sysext-build.sh"
[ "${1:-final}" = "final" ] || exit 0

# No units to activate: a toolchain is invoked by the operator, never
# started at boot. No SELinux work either — gcc, cmake and the -devel
# trees are all covered by base's selinux-policy-targeted, and
# sysext_finalize bakes the xattrs via mkfs.erofs --file-contexts.

# Fedora ships a handful of /usr paths as alternatives symlinks into
# /etc/alternatives/, and strip_to_sysext_layout deletes /etc from every
# sysext — so on a merged host each one dangles. /usr/bin/ld is the
# load-bearing case: gcc then cannot link anything, failing with
# "collect2: fatal error: cannot find 'ld'". Verified by installing this
# package set, removing /etc, and watching a hello-world fail to link.
# This package set also brings soelim (groff) and libnssckbi.so (p11-kit)
# in the same shape, hence the loop rather than a special case for ld.
#
# The absolute target is correct here: it resolves through the merged
# /usr on the host, which is where the real binary lives.
while IFS= read -r link; do
    alt=$(readlink "$link")
    target=$(readlink "$BUILDROOT$alt" 2>/dev/null || true)
    if [ -n "$target" ] && [ -e "$BUILDROOT$target" ]; then
        ln -sfn "$target" "$link"
        echo "devel: repointed ${link#"$BUILDROOT"} -> $target"
        continue
    fi
    # No target in the payload. Under /usr/share that is expected rather
    # than wrong — WithDocs=no drops the man pages some of these point at
    # (groff's soelim.1.gz) — and a dangling doc link is only dead weight,
    # so drop it. Anywhere else (bin, lib64) it is load-bearing and
    # shipping it would mean a toolchain that fails on a deployed host.
    case "${link#"$BUILDROOT"}" in
        /usr/share/*)
            rm -f "$link"
            echo "devel: dropped ${link#"$BUILDROOT"} (no target; WithDocs=no)"
            ;;
        *)
            echo "ERROR: ${link#"$BUILDROOT"} -> ${target:-$alt} has no target" >&2
            echo "       in the buildroot — the sysext would ship a broken tool." >&2
            exit 1
            ;;
    esac
done < <(find "$BUILDROOT/usr" -type l -lname '/etc/alternatives/*')

# Postcondition of the loop above: nothing may still route through
# /etc/alternatives/. Scoped to that directory ON PURPOSE. A /usr symlink
# into /etc is not broken in general — systemd's environment.d points at
# /etc/environment, containers-common's RHEL secrets dangle by design on
# Fedora, xml-common's catalog resolves only where docbook is configured —
# and all of those are equally true of the base image. What makes the
# alternatives case different is that /etc/alternatives/<name> is created
# ONLY by the package install inside this buildroot, so discarding this
# /etc is what orphans it; nothing on the host recreates it.
remaining=$(find "$BUILDROOT/usr" -type l -lname '/etc/alternatives/*' \
    -printf '  %P -> %l\n')
if [ -n "$remaining" ]; then
    echo "ERROR: alternatives symlinks survived the repoint above. /etc is" >&2
    echo "       stripped from the sysext, so these would dangle on a host:" >&2
    printf '%s\n' "$remaining" >&2
    exit 1
fi

# The linker resolves -lfoo through the unversioned symlink, so a -devel
# package that landed without one is a build failure on a deployed host
# and silence here. Check the two the reproducer actually tripped over,
# plus the tools the Rust cc crate and node-gyp invoke by literal name.
# `ld` is deliberately absent from this list — it is an absolute symlink
# after the repoint above, and `[ -e ]` would resolve that against the
# BUILD HOST's root; the loop asserts its target instead.
for f in usr/lib64/libz.so usr/lib64/libssl.so usr/bin/ar \
         usr/bin/cc usr/bin/c++ usr/include/stdio.h; do
    if [ ! -e "$BUILDROOT/$f" ]; then
        echo "ERROR: /$f missing — the devel sysext would ship a toolchain" >&2
        echo "       that cannot compile or link. Check the package set." >&2
        exit 1
    fi
done

sysext_write_extension_release devel

sysext_finalize "$@"
