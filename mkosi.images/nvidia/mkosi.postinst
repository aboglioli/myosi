#!/usr/bin/env bash
# Build NVIDIA sysext — current Turing+ branch, open kernel modules.
# Logic in mkosi.shared/nvidia-build.sh (shared with nvidia-580xx);
# helpers must live under mkosi.shared/ because mkosi v26 forbids
# BuildSources= in sub-image confs.

set -euo pipefail

STAGE="${1:-final}"
[ "$STAGE" = "final" ] || exit 0

export NVIDIA_BRANCH=current
source "${SRCDIR}/mkosi.shared/nvidia-build.sh"
