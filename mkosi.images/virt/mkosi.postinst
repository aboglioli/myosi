#!/usr/bin/env bash
set -euo pipefail

. "${SRCDIR}/mkosi.shared/sysext-build.sh"
[ "${1:-final}" = "final" ] || exit 0

# Unit activation is declarative: static .wants/ symlinks in the profile's
# mkosi.extra cover both baked and sysext delivery (modular libvirt socket
# triplets + virtqemud.service). libvirtd* deliberately excluded — the
# monolithic daemon fights the modular drivers.

# SELinux: virt types are already in base's selinux-policy-targeted, and
# sysext_finalize bakes xattrs via mkfs.erofs --file-contexts — no runtime
# semodule needed.

sysext_write_extension_release virt

sysext_finalize "$@"
