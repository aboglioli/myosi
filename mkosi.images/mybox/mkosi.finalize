#!/usr/bin/env bash
# mybox finalize.
#
# All work is shared with the main myosi image and lives in
# mkosi.shared/finalize-common.sh — /etc → /usr/share/factory/etc snapshot + /etc
# wipe + baseline-sysext bake (no current consumer). Single source of
# truth; behaviour stays in lockstep with main.

set -euo pipefail

source "${SRCDIR}/mkosi.shared/finalize-common.sh"
