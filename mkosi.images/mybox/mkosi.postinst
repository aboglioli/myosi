#!/usr/bin/env bash
# mybox postinst: shared baseline from mkosi.shared/postinst-common.sh
# (same source as the main image postinst) plus mybox-specific masks for
# boot-stack units that break inside nspawn.

set -euo pipefail

STAGE="${1:-final}"
[ "$STAGE" = "final" ] || exit 0

source "${SRCDIR}/mkosi.shared/postinst-common.sh"

# Mask only units that cannot run inside nspawn (verity/LUKS/repart/
# binfmt/ESP — nspawn handles or forbids all of them). Mask must live in
# /usr/lib/systemd/system/, not /etc/ (that would only land in the
# writable overlay). Everything else stays as preset-all wired it.
mask_units=(
    systemd-veritysetup@root.service
    systemd-cryptsetup@data.service
    systemd-repart.service
    systemd-binfmt.service
    efi.mount
    boot.mount
)

for unit in "${mask_units[@]}"; do
    if [ -f "$BUILDROOT/usr/lib/systemd/system/$unit" ] \
       || [ -f "$BUILDROOT/etc/systemd/system/$unit" ]; then
        ln -sf /dev/null "$BUILDROOT/usr/lib/systemd/system/$unit"
    fi
done

# Caveats: kmod sysexts merge .ko files the host kernel ignores (use
# host CDI bind for NVIDIA libs); SELinux works via erofs --file-contexts
# xattrs + container_t. Flatpak remotes not pre-seeded — operator runs
# `flatpak remote-add ... flathub` once on first boot.
