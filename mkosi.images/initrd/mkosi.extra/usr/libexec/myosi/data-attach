#!/usr/bin/env bash
# Attach the myosi data-luks pool to the booting host.
#
# Single responsibility: bring up the encrypted btrfs pool's device-
# mapper state so subsequent mount units (sysroot-etc.mount in the
# initrd; var.mount / home.mount / srv.mount post-pivot) have a live
# /dev/mapper/data to bind to. Anything beyond device unlock + btrfs
# scan belongs in its own unit (see myosi-etc-seed.service for the
# first-boot /etc seed + label).
#
# Steps:
#   1. Find the GPT Type=var partition on the SAME disk as the booted
#      root (guard rail: refuses to unlock a data-luks partition on a
#      different disk, which prevents an external USB myosi installer's
#      data-luks from getting auto-adopted into the running host).
#   2. LUKS-unlock that partition as /dev/mapper/data via the bootstrap
#      key file, with TPM2/passphrase fallback.
#   3. Discover and LUKS-unlock any additional data-N labeled LUKS
#      partitions on ANY disk in the system. These are operator-
#      configured multi-disk btrfs pool members (e.g. a host's secondary
#      LUKS disk) — discovery across disks is intentional.
#   4. `btrfs device scan` so the kernel knows about all members of the
#      multi-device btrfs.
#
# This script ran as `sysroot-prep` until the /etc-subvol refactor.
# Renamed because it no longer prepares /sysroot — it attaches the
# data pool. Mount logic, overlay setup, SELinux pre-seeding, and the
# first-boot /etc seed all moved out into separate units.

set -euo pipefail

VAR_TYPE_UUID=4d21b016-b534-45c2-a9fb-5c16e091fd2d
ROOT_TYPE_UUID=4f68bce3-e8cd-4db1-96e7-fbcaf984b709
KEY_FILE=/usr/share/myosi/keys/data.key
SYSROOT=/sysroot

die() {
    echo "data-attach: ERROR: $*" >&2
    exit 1
}

udev_partition_property() {
    # Read ID_PART_ENTRY_* properties from udev's per-device DB.
    # Why not `blkid -s PART_ENTRY_*`: blkid in the initrd silently
    # returns empty (exit 2, stderr swallowed) on dm-verity-backed
    # partitions — it tries to probe the FS layer and aborts before
    # reporting partition-table metadata. udev gathers ID_PART_ENTRY_*
    # at coldplug time from the parent disk's partition table, so the
    # values are always populated as long as udevadm settle ran first.
    #
    # Pure-bash parsing: mkosi-initrd ships no awk / grep / cut, so the
    # KEY=VALUE split uses `read` against a here-string of the property
    # dump (bash 4+ supports both IFS='=' read split and the `<<<` form
    # with -u set).
    local out k v
    out=$(udevadm info --query=property --name="$1" 2>/dev/null) || return 0
    while IFS='=' read -r k v; do
        if [ "$k" = "$2" ]; then
            printf '%s' "$v"
            return 0
        fi
    done <<< "$out"
}

partition_type() {
    udev_partition_property "$1" ID_PART_ENTRY_TYPE | tr '[:upper:]' '[:lower:]'
}

partition_label() {
    udev_partition_property "$1" ID_PART_ENTRY_NAME
}

collect_partition_slaves() {
    local node="$1"
    local sys="/sys/class/block/${node}"

    [ -e "$sys" ] || return 0

    if [ -f "$sys/partition" ]; then
        printf '/dev/%s\n' "$node"
        return 0
    fi

    local slave
    for slave in "$sys"/slaves/*; do
        [ -e "$slave" ] || continue
        collect_partition_slaves "$(basename "$slave")"
    done
}

sysroot_source() {
    findmnt -n -o SOURCE --target "$SYSROOT" 2>/dev/null || true
}

root_partition() {
    local source node candidate type label
    source=$(sysroot_source)
    [ -n "$source" ] || die "could not resolve $SYSROOT mount source"

    node=$(basename "$(readlink -f "$source")")
    [ -n "$node" ] || die "could not resolve block node for $source"

    while IFS= read -r candidate; do
        [ -n "$candidate" ] || continue
        type=$(partition_type "$candidate")
        label=$(partition_label "$candidate")
        if [ "$type" = "$ROOT_TYPE_UUID" ] && [[ "$label" == root-* ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done < <(collect_partition_slaves "$node")

    die "could not find root GPT partition behind $source"
}

parent_disk() {
    local node sys real parent
    node=$(basename "$1")
    sys="/sys/class/block/${node}"
    [ -f "$sys/partition" ] || die "$1 is not a partition"

    real=$(readlink -f "$sys")
    parent=$(basename "$(dirname "$real")")
    [ -n "$parent" ] || die "could not resolve parent disk for $1"
    printf '/dev/%s\n' "$parent"
}

var_partition_on_disk() {
    # Guard rail: the primary data partition MUST be on the same disk
    # as the booted root. Without this guard, plugging in an external
    # USB myosi installer with its own data-luks would have its
    # partition unlocked into the running host's /dev/mapper/data.
    local disk="$1"
    local disk_node disk_sys found= part_sys candidate type

    disk_node=$(basename "$disk")
    disk_sys="/sys/class/block/${disk_node}"
    [ -e "$disk_sys" ] || die "could not find sysfs node for $disk"

    for part_sys in "$disk_sys"/*; do
        [ -f "$part_sys/partition" ] || continue
        candidate="/dev/$(basename "$part_sys")"
        type=$(partition_type "$candidate")
        [ "$type" = "$VAR_TYPE_UUID" ] || continue

        if [ -n "$found" ]; then
            die "multiple Type=var partitions found on $disk: $found and $candidate"
        fi
        found="$candidate"
    done

    [ -n "$found" ] || die "no Type=var partition found on $disk"
    printf '%s\n' "$found"
}

unlock_one() {
    local name="$1" dev="$2"
    local mapper="/dev/mapper/${name}"

    if [ -e "$mapper" ]; then
        return 0
    fi

    if [ -r "$KEY_FILE" ] && \
        cryptsetup luksOpen --test-passphrase --key-file "$KEY_FILE" "$dev" >/dev/null 2>&1; then
        echo "data-attach: unlocking $name via key-file"
        systemd-cryptsetup attach "$name" "$dev" "$KEY_FILE" discard
        return 0
    fi

    echo "data-attach: $name key-file not usable, trying TPM2 then passphrase"
    systemd-cryptsetup attach "$name" "$dev" - tpm2-device=auto,discard
}

unlock_primary_data() {
    unlock_one data "$1"
}

unlock_pool_members() {
    # Pool members are discovered ACROSS the system (not constrained to
    # the root disk like the primary data partition is). This matches
    # operator-configured multi-disk btrfs pools: a host may use a secondary
    # LUKS disk as a data-N pool member. Discovery across disks here is
    # intentional — operators who plug in a data-N labeled LUKS
    # partition want it adopted.
    local dev label primary="$1"

    while IFS= read -r dev; do
        [ -n "$dev" ] || continue
        [ "$dev" != "$primary" ] || continue

        label=$(blkid -s LABEL -o value "$dev" 2>/dev/null || true)
        [[ "$label" =~ ^data-[0-9]+$ ]] || continue

        unlock_one "$label" "$dev"
    done < <(blkid -t TYPE=crypto_LUKS -o device)
}

udevadm settle

root_part=$(root_partition)
root_disk=$(parent_disk "$root_part")
var_part=$(var_partition_on_disk "$root_disk")

echo "data-attach: root=$root_part disk=$root_disk var=$var_part"

unlock_primary_data "$var_part"
udevadm settle
unlock_pool_members "$var_part"
udevadm settle

# Tell the kernel about every member of the multi-device btrfs before
# sysroot-etc.mount and the post-pivot var.mount / home.mount /
# srv.mount fire. Without `btrfs device scan`, the first mount sees
# only the primary device and rejects subvol mounts that span pool
# members.
btrfs device scan /dev/mapper/data /dev/mapper/data-* 2>/dev/null || true
