[Unit]
Description=Attach myosi data-luks pool (LUKS unlock + btrfs scan)
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
DefaultDependencies=no
# Dependency hygiene (applies to the whole /etc chain): IgnoreOnIsolate
# survives the pre-pivot isolate; Wants= NOT Requires= on upstream units
# (they're outside initrd-switch-root's transaction — Requires= would
# cascade-stop us, and IgnoreOnIsolate doesn't block that); OnFailure
# drops to emergency instead of pivoting broken; static .wants symlinks
# in BOTH initrd.target.wants/ and initrd-switch-root.target.wants/ are
# what activate the unit — mkosi-initrd never runs preset-all.
IgnoreOnIsolate=yes
OnFailure=emergency.target
# No systemd-udev-settle.service: it is deprecated (udevadm logs
# "Please fix myosi-data-attach.service not to pull it in") and redundant
# here — data-attach runs `udevadm settle` itself, at the three points it
# actually needs a drained queue, which is the same guarantee scoped to
# this unit instead of the whole initrd transaction.
After=sysroot.mount systemd-repart.service systemd-udevd.service cryptsetup-pre.target
Wants=sysroot.mount systemd-repart.service
Before=sysroot-etc.mount myosi-etc-seed.service initrd.target initrd-switch-root.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=infinity
# Mirror to console — without it a LUKS/btrfs failure is a silent hang.
StandardOutput=journal+console
StandardError=journal+console
ExecStart=/usr/libexec/myosi/data-attach

[Install]
WantedBy=initrd.target initrd-switch-root.target
