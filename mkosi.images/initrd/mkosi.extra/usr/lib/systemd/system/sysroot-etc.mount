[Unit]
Description=/sysroot/etc btrfs subvolume on data-luks
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
DefaultDependencies=no
# Dependency rationale: see myosi-data-attach.service — same rules for
# every unit in the /etc chain.
IgnoreOnIsolate=yes
OnFailure=emergency.target
After=myosi-data-attach.service
Wants=myosi-data-attach.service
Before=myosi-etc-seed.service initrd.target initrd-switch-root.target

[Mount]
# /etc is a real btrfs subvolume, not an overlay. First-boot seeding from
# /usr/share/factory/etc happens in myosi-etc-seed.service (must finish
# pre-pivot: PID 1 reads /etc/selinux/config synchronously at startup).
# A failed mount drops to the initrd emergency shell via OnFailure=.
What=/dev/mapper/data
Where=/sysroot/etc
Type=btrfs
Options=defaults,noatime,compress=zstd:3,subvol=/etc

[Install]
WantedBy=initrd.target initrd-switch-root.target
