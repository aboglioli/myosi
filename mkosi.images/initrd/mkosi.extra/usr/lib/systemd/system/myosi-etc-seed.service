[Unit]
Description=Seed empty /etc subvol from /usr/share/factory/etc factory tree + label root
Documentation=https://github.com/aboglioli/myosi/blob/main/README.md
DefaultDependencies=no
# See myosi-data-attach.service for the full dependency rationale.
# Same rules for every unit in the /etc chain.
IgnoreOnIsolate=yes
OnFailure=emergency.target
After=sysroot-etc.mount
Wants=sysroot-etc.mount
Before=initrd.target initrd-switch-root.target
# First boot only — /etc populated later, and the SELinux xattr on the
# subvol root persists across mounts.
ConditionDirectoryNotEmpty=!/sysroot/etc

[Service]
Type=oneshot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
# cp -a preserves etc_t labels (factory tree is relabeled as /etc via
# file_contexts.subs); setfattr stamps the subvol root inode, which
# `btrfs subvolume create` leaves without any security.selinux xattr.
ExecStart=/usr/bin/cp -a --reflink=auto /sysroot/usr/share/factory/etc/. /sysroot/etc/
ExecStart=/usr/bin/setfattr -n security.selinux -v system_u:object_r:etc_t:s0 /sysroot/etc

[Install]
WantedBy=initrd.target initrd-switch-root.target
