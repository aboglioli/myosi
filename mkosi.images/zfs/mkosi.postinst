#!/usr/bin/env bash
# Build OpenZFS sysext (kmod + userspace); logic in
# mkosi.shared/zfs-build.sh. OpenZFS lags major kernel bumps — set
# ZFS_BUILD_OPTIONAL=1 to make rpmbuild failures non-fatal (warn +
# exit 0, no kmod) so the rest of the build still ships.

set -euo pipefail

STAGE="${1:-final}"
[ "$STAGE" = "final" ] || exit 0

source "${SRCDIR}/mkosi.shared/zfs-build.sh"
