#!/usr/bin/env bash
# Main myosi image postinst. Shared baseline (preset-all, SELinux
# factory-/etc subs, /root|/mnt symlinks, /srv mountpoint, version
# metadata) lives in mkosi.shared/postinst-common.sh; this wrapper
# adds the main-image-only steps: MOK signing certs and the LUKS
# bootstrap data.key into /usr/share/myosi/keys/ + /efi/keys/.

set -euo pipefail

STAGE="${1:-final}"
[ "$STAGE" = "final" ] || exit 0

SRCDIR="${SRCDIR:-$(dirname "$(realpath "${BASH_SOURCE[0]}")")}"

source "${SRCDIR}/mkosi.shared/postinst-common.sh"

# Ship public signing certs for MOK enrollment (private keys never
# reach the image). Both PEM and DER — `mokutil --import` rejects PEM.
# Two destinations: /usr/share/myosi/keys/ for runtime operator use,
# and /efi/keys/ on the ESP so UEFI firmware's file browser can read
# them during db/KEK/PK enrollment (firmware can't read erofs).
mkdir -p "$BUILDROOT/usr/share/myosi/keys" "$BUILDROOT/efi/keys"
for cert in boot image; do
    src="$SRCDIR/keys/${cert}.crt"
    if [ -f "$src" ]; then
        install -m 0644 "$src" "$BUILDROOT/usr/share/myosi/keys/${cert}.crt"
        openssl x509 -in "$src" -outform DER \
                -out "$BUILDROOT/usr/share/myosi/keys/${cert}.der"
        chmod 0644 "$BUILDROOT/usr/share/myosi/keys/${cert}.der"
        install -m 0644 "$BUILDROOT/usr/share/myosi/keys/${cert}.der" \
                        "$BUILDROOT/efi/keys/${cert}.der"
    fi
done

# Bootstrap LUKS key: raw 32-byte PRIVATE material (mode 0600, no
# PEM/DER conversion). repart formats LUKS slot 0 with it at first boot
# and crypttab reads it every boot until the operator wipes slot 0.
# Written by scripts/generate-bootstrap-key.sh.
DATA_KEY_SRC="$SRCDIR/keys/data.key"
if [ -f "$DATA_KEY_SRC" ]; then
    install -m 0600 "$DATA_KEY_SRC" "$BUILDROOT/usr/share/myosi/keys/data.key"
    install -m 0600 "$DATA_KEY_SRC" "$BUILDROOT/efi/keys/data.key"
else
    echo "postinst: WARNING $DATA_KEY_SRC missing — repart Encrypt=key-file will fail at first boot" >&2
fi
