#!/usr/bin/env bash
# Single source of truth for ImageVersion across base + every sub-image.
# mkosi reads this file's stdout (it's executable) and uses the output as
# the ImageVersion= value.
#
# Formats accepted:
#   YYYY.MM.DD.NN              stable release        (2026.06.03.01)
#   YYYY.MM.DD.NN-rc.N         release candidate     (2026.06.03.01-rc.1)
#   YYYY.MM.DD.NN-beta.N       beta prerelease       (2026.06.03.01-beta.2)
#   YYYY.MM.DD.NN-alpha.N      alpha prerelease      (2026.06.03.01-alpha.3)
#
# The .NN suffix is a same-day build counter (01, 02, ...) that increments
# every time `just build` is invoked, and resets to 01 on a new day. The
# prerelease suffix is only ever set via $MYOSI_VERSION (CI workflow) — the
# local build path never emits prerelease versions automatically.
#
# Resolution order:
#   1. $MYOSI_VERSION env var (CI release tag, dispatch input, or explicit override)
#   2. Git tag of HEAD matching one of the formats above. Tags are bare — no
#      leading 'v' or 'myosi-' prefix — so sysupdate URLs resolve to release
#      assets directly via @v interpolation.
#   3. Today's UTC date + persistent counter from build/.version-counter
#
# Caching: mkosi invokes this script once per (sub-)image during a single
# build, potentially ~10 times within seconds. To keep the version stable
# across all of those, we cache the result in build/.version-current with
# an mtime-based freshness window (CACHE_TTL seconds). A fresh build session
# more than CACHE_TTL after the last invocation gets a new counter value.

set -euo pipefail

CACHE_TTL=300  # 5 min; longer than the time between mkosi sub-image dispatches,
               # shorter than the gap between two distinct `just build` runs.

if [ -n "${MYOSI_VERSION:-}" ]; then
    printf '%s' "$MYOSI_VERSION"
    exit 0
fi

TAG=$(git describe --tags --exact-match 2>/dev/null || true)
if [[ "$TAG" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]{2}(-(alpha|beta|rc)\.[0-9]+)?$ ]]; then
    printf '%s' "$TAG"
    exit 0
fi
# Backwards-compat: accept legacy YYYY.MM.DD tags (no .NN), pad to .01.
if [[ "$TAG" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}$ ]]; then
    printf '%s.01' "$TAG"
    exit 0
fi

MYOSI_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
BUILD_DIR="$MYOSI_ROOT/build"
mkdir -p "$BUILD_DIR"

CURRENT_FILE="$BUILD_DIR/.version-current"
COUNTER_FILE="$BUILD_DIR/.version-counter"
TODAY=$(date -u +%Y.%m.%d)

# Return cached value if marker is fresh enough to be from the same build session.
if [ -f "$CURRENT_FILE" ]; then
    NOW=$(date -u +%s)
    MTIME=$(stat -c %Y "$CURRENT_FILE" 2>/dev/null || echo 0)
    AGE=$((NOW - MTIME))
    if [ "$AGE" -lt "$CACHE_TTL" ]; then
        CACHED=$(cat "$CURRENT_FILE")
        # Only honor the cache if its date prefix matches today — otherwise
        # the day rolled over mid-cache-window and we want a fresh counter.
        if [[ "$CACHED" == "$TODAY".* ]]; then
            printf '%s' "$CACHED"
            exit 0
        fi
    fi
fi

# Compute fresh counter. Counter file format: "YYYY.MM.DD NN"
COUNTER=1
if [ -f "$COUNTER_FILE" ]; then
    read -r STORED_DATE STORED_NN < "$COUNTER_FILE" || true
    if [ "${STORED_DATE:-}" = "$TODAY" ]; then
        COUNTER=$((10#${STORED_NN:-0} + 1))
    fi
fi

VERSION=$(printf '%s.%02d' "$TODAY" "$COUNTER")
printf '%s %02d\n' "$TODAY" "$COUNTER" > "$COUNTER_FILE"
printf '%s' "$VERSION" > "$CURRENT_FILE"
printf '%s' "$VERSION"
