#!/usr/bin/env bash
# Single source of truth for ImageVersion (mkosi runs this executable
# and uses its stdout). Format: YYYY.MM.DD.NN[-alpha|-beta|-rc.N].
# Resolution: $MYOSI_VERSION → exact git tag of HEAD (bare, no 'v'
# prefix, so sysupdate @v resolves release assets) → UTC date + counter.
# mkosi invokes this ~10x per build; build/.version-current caches the
# result (mtime TTL) so every sub-image agrees on one version.

set -euo pipefail

CACHE_TTL=300  # longer than sub-image dispatch gaps, shorter than distinct build runs

if [ -n "${MYOSI_VERSION:-}" ]; then
    printf '%s' "$MYOSI_VERSION"
    exit 0
fi

TAG=$(git describe --tags --exact-match 2>/dev/null || true)
if [[ "$TAG" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]{2}(-(alpha|beta|rc)\.[0-9]+)?$ ]]; then
    printf '%s' "$TAG"
    exit 0
fi
# Legacy YYYY.MM.DD tags (no .NN) pad to .01.
if [[ "$TAG" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}$ ]]; then
    printf '%s.01' "$TAG"
    exit 0
fi

MYOSI_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
BUILD_DIR="$MYOSI_ROOT/build"
mkdir -p "$BUILD_DIR"

CURRENT_FILE="$BUILD_DIR/.version-current"
COUNTER_FILE="$BUILD_DIR/.version-counter"
TODAY=$(date -u +%Y.%m.%d)

# Return cached value if marker is fresh enough to be from the same build session.
if [ -f "$CURRENT_FILE" ]; then
    NOW=$(date -u +%s)
    MTIME=$(stat -c %Y "$CURRENT_FILE" 2>/dev/null || echo 0)
    AGE=$((NOW - MTIME))
    if [ "$AGE" -lt "$CACHE_TTL" ]; then
        CACHED=$(cat "$CURRENT_FILE")
        # Ignore the cache if the day rolled over mid-window.
        if [[ "$CACHED" == "$TODAY".* ]]; then
            printf '%s' "$CACHED"
            exit 0
        fi
    fi
fi

# Compute fresh counter. Counter file format: "YYYY.MM.DD NN"
COUNTER=1
if [ -f "$COUNTER_FILE" ]; then
    read -r STORED_DATE STORED_NN < "$COUNTER_FILE" || true
    if [ "${STORED_DATE:-}" = "$TODAY" ]; then
        COUNTER=$((10#${STORED_NN:-0} + 1))
    fi
fi

VERSION=$(printf '%s.%02d' "$TODAY" "$COUNTER")
printf '%s %02d\n' "$TODAY" "$COUNTER" > "$COUNTER_FILE"
printf '%s' "$VERSION" > "$CURRENT_FILE"
printf '%s' "$VERSION"
