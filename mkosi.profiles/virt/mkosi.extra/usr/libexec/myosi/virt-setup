#!/usr/bin/env bash
#
# Host setup for the virt sysext: a NetworkManager bridge br0 so guests are
# LAN peers with their own MAC and router-assigned IP, plus the matching
# libvirt network. Run once after `myosi extension-enable virt`. Idempotent.
#
# Storage is deliberately not configured here. /var/lib/libvirt/{images,isos}
# come from the sysext's tmpfiles drop-in with the right modes and stock
# SELinux labels, and domains reference disks by absolute path, so no libvirt
# pool is needed. The NAT network is not defined either: it exists only for
# guests that must NOT be on the LAN, which is the opposite of the point here.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
. "${SCRIPT_DIR}/lib.sh"

require_root

# Target the system instance regardless of the caller's environment.
export LIBVIRT_DEFAULT_URI=qemu:///system

IFACE=""
for arg in "$@"; do
    case "$arg" in
        --bridge-iface=*) IFACE="${arg#*=}" ;;
        -h|--help)
            cat >&2 <<'EOF'
Usage: /usr/libexec/myosi/virt-setup [--bridge-iface=<iface>]

  --bridge-iface=<iface>  Physical iface to enslave to br0.
                          Default: auto-detect from the default route.
EOF
            exit 0 ;;
        *) echo "ERROR: unknown arg: $arg" >&2; exit 2 ;;
    esac
done

setup_bridge() {
    if ip link show br0 >/dev/null 2>&1; then
        echo "Bridge br0 already exists."
        return 0
    fi

    # Single-pass awk, no `exit`: under pipefail an early exit SIGPIPEs the
    # writer and the assignment fails with 141.
    if [ -z "$IFACE" ]; then
        IFACE=$(ip -4 route show default 2>/dev/null \
                | awk '!f {print $5; f=1}') || true
    fi
    if [ -z "$IFACE" ] || ! ip link show "$IFACE" >/dev/null 2>&1; then
        echo "ERROR: no usable iface (got '${IFACE:-none}'). Pass --bridge-iface=." >&2
        ip -br link | awk '$1 != "lo" {print "  " $1}' >&2
        exit 3
    fi
    # A station-mode 802.11 link drops frames whose source MAC is not its
    # own, so a bridged guest's traffic disappears. Ethernet only.
    if [ -e "/sys/class/net/$IFACE/wireless" ] || [ -e "/sys/class/net/$IFACE/phy80211" ]; then
        echo "ERROR: $IFACE is wireless; a WiFi station cannot be bridged." >&2
        exit 3
    fi

    # br0 takes the slave's MAC so the host keeps its own DHCP reservation.
    local mac old
    mac=$(cat "/sys/class/net/$IFACE/address")
    old=$(nmcli -t -f NAME,DEVICE con show --active 2>/dev/null \
          | awk -F: -v d="$IFACE" '$2 == d && !f {print $1; f=1}') || true

    if [ -n "${SSH_CONNECTION:-}" ]; then
        echo "NOTE: over SSH — $IFACE drops for 5-30 s while br0 takes over."
    fi

    # A failure past this point leaves a headless host with no way back in.
    # Undo both halves, so a re-run starts clean instead of finding a
    # bridge with no uplink.
    restore() {
        nmcli con delete br0 "br0-$IFACE" >/dev/null 2>&1 || true
        [ -n "$old" ] && nmcli con up "$old" >/dev/null 2>&1 || true
    }
    trap restore EXIT

    echo "Creating br0 with $IFACE as slave..."
    nmcli con add type bridge ifname br0 con-name br0 \
        bridge.stp no bridge.mac-address "$mac" \
        ipv4.method auto ipv6.method auto
    nmcli con add type ethernet ifname "$IFACE" master br0 con-name "br0-$IFACE"
    [ -n "$old" ] && nmcli con down "$old" >/dev/null 2>&1 || true
    nmcli con up br0
    nmcli con up "br0-$IFACE"

    trap - EXIT
    ip -br addr show br0
}

setup_network() {
    if ! command -v virsh >/dev/null; then
        echo "ERROR: virsh missing. Run: sudo myosi extension-enable virt" >&2
        exit 4
    fi
    if ! virsh list >/dev/null 2>&1; then
        echo "ERROR: cannot reach qemu:///system (check virtqemud.socket)." >&2
        exit 5
    fi
    if virsh net-info br0 >/dev/null 2>&1; then
        echo "libvirt network br0 already defined."
        return 0
    fi

    local xml
    xml=$(mktemp)
    trap 'rm -f "$xml"' RETURN
    cat > "$xml" <<'EOF'
<network>
  <name>br0</name>
  <forward mode='bridge'/>
  <bridge name='br0'/>
</network>
EOF
    echo "Defining libvirt network br0..."
    virsh net-define "$xml"
    virsh net-autostart br0
    virsh net-start br0 2>/dev/null || true
}

setup_bridge
setup_network

echo
echo "Done. Attach guests with:  <interface type='network'><source network='br0'/>"
