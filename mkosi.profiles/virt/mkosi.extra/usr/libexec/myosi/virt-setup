#!/usr/bin/env bash
#
# Host setup for the virt sysext: the libvirt network pointing at the host
# LAN bridge. Run once after `myosi extension-enable virt`. Idempotent.
#
# The bridge itself lives in the base image (`myosi bridge-create`); this
# script only calls it when the bridge is missing.
#
# No storage pool and no NAT network on purpose: /var/lib/libvirt/{images,isos}
# come from the sysext's tmpfiles drop-in and domains use absolute paths, and
# virbr0 is for guests that must NOT be on the LAN.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
. "${SCRIPT_DIR}/lib.sh"

require_root

# Target the system instance regardless of the caller's environment.
export LIBVIRT_DEFAULT_URI=qemu:///system

BRIDGE_SETUP="${SCRIPT_DIR}/bridge-setup"
BRIDGE=br0
IFACE=""

for arg in "$@"; do
    case "$arg" in
        --bridge-iface=*) IFACE="${arg#*=}" ;;
        --bridge=*)       BRIDGE="${arg#*=}" ;;
        -h|--help)
            cat >&2 <<'EOF'
Usage: /usr/libexec/myosi/virt-setup [--bridge=<name>] [--bridge-iface=<iface>]

  --bridge=<name>         Bridge to attach guests to. Default: br0.
  --bridge-iface=<iface>  Physical iface to enslave, when the bridge has
                          to be created. Default: auto-detect from the
                          default route.
EOF
            exit 0 ;;
        *) echo "ERROR: unknown arg: $arg" >&2; exit 2 ;;
    esac
done

validate_name "$BRIDGE" bridge

setup_bridge() {
    if ip link show "$BRIDGE" >/dev/null 2>&1; then
        echo "Bridge $BRIDGE already exists."
        return 0
    fi
    if [ ! -x "$BRIDGE_SETUP" ]; then
        echo "ERROR: $BRIDGE_SETUP missing — cannot create $BRIDGE." >&2
        exit 3
    fi
    local args=(create "--name=$BRIDGE")
    [ -n "$IFACE" ] && args+=("--iface=$IFACE")
    "$BRIDGE_SETUP" "${args[@]}"
}

setup_network() {
    if ! command -v virsh >/dev/null; then
        echo "ERROR: virsh missing. Run: sudo myosi extension-enable virt" >&2
        exit 4
    fi
    if ! virsh list >/dev/null 2>&1; then
        echo "ERROR: cannot reach qemu:///system (check virtqemud.socket)." >&2
        exit 5
    fi
    if virsh net-info "$BRIDGE" >/dev/null 2>&1; then
        echo "libvirt network $BRIDGE already defined."
        return 0
    fi

    local xml
    xml=$(mktemp)
    trap 'rm -f "$xml"' RETURN
    cat > "$xml" <<EOF
<network>
  <name>${BRIDGE}</name>
  <forward mode='bridge'/>
  <bridge name='${BRIDGE}'/>
</network>
EOF
    echo "Defining libvirt network $BRIDGE..."
    virsh net-define "$xml"
    virsh net-autostart "$BRIDGE"
    virsh net-start "$BRIDGE" 2>/dev/null || true
}

setup_bridge
setup_network

echo
echo "Done. Attach guests with:  <interface type='network'><source network='${BRIDGE}'/>"
