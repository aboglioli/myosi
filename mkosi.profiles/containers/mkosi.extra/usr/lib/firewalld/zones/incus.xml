<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissive zone for Incus bridges. Without it firewalld puts incusbr0's
  veth pairs in the default `public` zone, which eats DHCPv4 OFFER replies
  between dnsmasq and the container: IPv6 only, no NAT'd internet. Incus's
  own nftables table still enforces policy.

  A custom zone rather than editing `trusted`: zone XML is one file per zone
  with no drop-in merging, so two packages shipping trusted.xml would clobber
  each other. Shipping our own matches libvirt and Tailscale.

  Operator override: /etc/firewalld/zones/incus.xml wins over this one.

  NOTE: never write a double hyphen in this comment, not even inside a
  quoted command. XML forbids it, and firewalld reacts by failing its whole
  stock config load and exiting 0: no firewall at all, and the failed-unit
  list stays clean, so nothing surfaces it.
-->
<zone target="ACCEPT">
  <short>Incus</short>
  <description>Permissive zone for Incus-managed bridges (incusbr*).</description>
  <interface name="incusbr0"/>
</zone>
